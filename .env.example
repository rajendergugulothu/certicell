# --- Database (Turso / libSQL) ---------------------------------------------
# turso db show <name> --url   →  libsql://<name>-<org>.turso.io
TURSO_DATABASE_URL=
# turso db tokens create <name>
TURSO_AUTH_TOKEN=

# --- File storage (Vercel Blob) --------------------------------------------
# Added automatically when you connect a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
# The store's public base, e.g. https://<id>.public.blob.vercel-storage.com
BLOB_PUBLIC_BASE_URL=

# --- Auth.js ----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Set to your deployed origin in production, e.g. https://certicell.vercel.app
AUTH_URL=

# At least one provider must be configured, or nobody can sign in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required for local development only. On Vercel, Auth.js trusts the
# deployment host automatically and this can be left unset.
AUTH_TRUST_HOST=true
